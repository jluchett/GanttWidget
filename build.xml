<?xml version="1.0" encoding="UTF-8"?>
<project name="gantt-fleet-app" default="war" basedir=".">
    <property name="src.dir" value="src" />
    <property name="web.dir" value="WebContent" />
    <property name="build.dir" value="build" />
    <property name="classes.dir" value="${build.dir}/WEB-INF/classes" />
    <property name="dist.dir" value="dist" />
    <property name="war.name" value="gantt-fleet.war" />
    
    <!-- Ruta al directorio de instalación de Tomcat 9 -->
    <property name="tomcat.home" value="C:/Program Files/Apache/apache-tomcat-9.0.97" />

    <path id="classpath">
        <fileset dir="${web.dir}/WEB-INF/lib" includes="*.jar" />
        <fileset dir="${tomcat.home}/lib" includes="servlet-api.jar,jsp-api.jar,el-api.jar" />
    </path>

    <target name="clean">
        <delete dir="${build.dir}" />
        <delete dir="${dist.dir}" />
    </target>

    <target name="init" depends="clean">
        <mkdir dir="${classes.dir}" />
        <mkdir dir="${dist.dir}" />
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false"
               source="1.8" target="1.8" encoding="UTF-8" classpathref="classpath" debug="true" />
    </target>

    <target name="war" depends="compile">
        <copy todir="${build.dir}">
            <fileset dir="${web.dir}" />
        </copy>
        <war destfile="${dist.dir}/${war.name}" webxml="${web.dir}/WEB-INF/web.xml">
            <fileset dir="${build.dir}" />
        </war>
        <echo message="Archivo WAR generado con exito en ${dist.dir}/${war.name}" />
    </target>

    <!-- Tarea para descargar automáticamente todas las dependencias requeridas -->
    <target name="download-libs">
        <property name="lib.dir" value="${web.dir}/WEB-INF/lib" />
        <mkdir dir="${lib.dir}" />

        <!-- 1. JSF 2.3 (Mojarra) -->
        <get src="https://repo1.maven.org/maven2/org/glassfish/javax.faces/2.3.9/javax.faces-2.3.9.jar"
             dest="${lib.dir}/javax.faces-2.3.9.jar" skipexisting="true" />

        <!-- 2. Jackson Annotations -->
        <get src="https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-annotations/2.13.4/jackson-annotations-2.13.4.jar"
             dest="${lib.dir}/jackson-annotations-2.13.4.jar" skipexisting="true" />

        <!-- 3. Jackson Core -->
        <get src="https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-core/2.13.4/jackson-core-2.13.4.jar"
             dest="${lib.dir}/jackson-core-2.13.4.jar" skipexisting="true" />

        <!-- 4. Jackson Databind -->
        <get src="https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-databind/2.13.4.2/jackson-databind-2.13.4.2.jar"
             dest="${lib.dir}/jackson-databind-2.13.4.2.jar" skipexisting="true" />

        <!-- 5. Jackson JavaTime (JSR-310 para LocalDate / LocalDateTime) -->
        <get src="https://repo1.maven.org/maven2/com/fasterxml/jackson/datatype/jackson-datatype-jsr310/2.13.4/jackson-datatype-jsr310-2.13.4.jar"
             dest="${lib.dir}/jackson-datatype-jsr310-2.13.4.jar" skipexisting="true" />

        <echo message="Librerias descargadas exitosamente en ${lib.dir}" />
    </target>
    
</project>